      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst body = $json.body || $json;\nconst headers = $json.headers || {};\nconst token = String(headers['x-rss-token'] || headers['X-RSS-Token'] || '');\nconst EXPECTED_TOKEN = 'REPLACE_WITH_YOUR_API_TOKEN';\n\n// Constant-time comparison — a plain !== leaks how many leading characters matched\n// via response-time differences, letting an attacker brute-force the token byte by byte.\nfunction timingSafeStringEqual(a, b) {\n  const hashA = crypto.createHash('sha256').update(String(a)).digest();\n  const hashB = crypto.createHash('sha256').update(String(b)).digest();\n  return crypto.timingSafeEqual(hashA, hashB);\n}\n\nif (!timingSafeStringEqual(token, EXPECTED_TOKEN)) {\n  return [{ json: { valid: false, httpStatus: 401, errorMsg: 'Unauthorized' } }];\n}\n\nconst subject = String(body.subject || '').trim();\nconst body_html = String(body.body_html || '').trim();\n\nif (!subject || !body_html) {\n  return [{ json: { valid: false, httpStatus: 400, errorMsg: 'Missing required fields: subject, body_html' } }];\n}\n\nconst guid = crypto.randomUUID();\nconst pubDate = new Date().toISOString();\n\nreturn [{ json: {\n  valid: true,\n  httpStatus: 200,\n  guid,\n  title: subject,\n  body_html,\n  featured_image_url: String(body.featured_image_url || ''),\n  pub_date: pubDate,\n  discordMessage: `✅ Manual draft queued: **${subject}**\\n\\nguid: \\`${guid}\\`\\n→ Beehiiv picks it up within the hour.`\n} }];"
      },
