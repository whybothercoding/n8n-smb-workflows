{
  "name": "[StackSignal] Manual RSS Push",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rss-push",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-rss-push",
      "name": "Manual Push Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        16
      ],
      "webhookId": "rss-push",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst headers = $json.headers || {};\nconst token = String(headers['x-rss-token'] || headers['X-RSS-Token'] || '');\nconst EXPECTED_TOKEN = 'REPLACE_WITH_YOUR_API_TOKEN';\n\nif (token !== EXPECTED_TOKEN) {\n  return [{ json: { valid: false, httpStatus: 401, errorMsg: 'Unauthorized' } }];\n}\n\nconst subject = String(body.subject || '').trim();\nconst body_html = String(body.body_html || '').trim();\n\nif (!subject || !body_html) {\n  return [{ json: { valid: false, httpStatus: 400, errorMsg: 'Missing required fields: subject, body_html' } }];\n}\n\nconst crypto = require('crypto');\nconst guid = crypto.randomUUID();\nconst pubDate = new Date().toISOString();\n\nreturn [{ json: {\n  valid: true,\n  httpStatus: 200,\n  guid,\n  title: subject,\n  body_html,\n  featured_image_url: String(body.featured_image_url || ''),\n  pub_date: pubDate,\n  slackMessage: `\u2705 Manual draft queued: *${subject}*\\n\\nguid: \\`${guid}\\`\\n\u2192 Beehiiv picks it up within the hour.`\n} }];"
      },
      "id": "validate-prepare",
      "name": "Validate & Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        16
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "valid-check",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-valid",
      "name": "Valid Request?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        448,
        16
      ]
    },
    {
      "parameters": {
        "authentication": "databaseToken",
        "operation": "create",
        "tableId": "YOUR_BASEROW_TABLE_ID",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "7283",
              "fieldValue": "={{ $json.title }}"
            },
            {
              "fieldId": "7286",
              "fieldValue": "={{ $json.guid }}"
            },
            {
              "fieldId": "7287",
              "fieldValue": "={{ $json.body_html }}"
            },
            {
              "fieldId": "7288",
              "fieldValue": "={{ $json.featured_image_url }}"
            },
            {
              "fieldId": "7289",
              "fieldValue": "={{ $json.pub_date }}"
            },
            {
              "fieldId": "7290",
              "fieldValue": "manual"
            },
            {
              "fieldId": "7291",
              "fieldValue": "queued"
            }
          ]
        }
      },
      "id": "baserow-push-insert",
      "name": "Insert into RSS Items",
      "type": "n8n-nodes-base.baserow",
      "typeVersion": 1.1,
      "position": [
        672,
        -80
      ],
      "credentials": {
        "baserowTokenApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Baserow"
        }
      }
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "C09L63MUFS4",
          "mode": "list",
          "cachedResultName": "stacksignal-news"
        },
        "text": "={{ $node['Validate & Prepare'].json.slackMessage }}",
        "otherOptions": {},
        "resource": "message",
        "operation": "post"
      },
      "id": "slack-push",
      "name": "Slack Confirmation",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.4,
      "position": [
        896,
        -80
      ],
      "webhookId": "YOUR_WEBHOOK_ID",
      "credentials": {
        "slackOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Slack OAuth 2.0 API"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ queued: true, guid: $node['Validate & Prepare'].json.guid }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-200",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1120,
        -80
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: $json.errorMsg }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "respond-error",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        672,
        112
      ]
    }
  ],
